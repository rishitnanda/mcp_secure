{
  "trust_mode": "prompt",
  "default": {
    "regex_blacklist": [
      "rm\\s+-rf",
      "chmod\\s+\\+x",
      "/etc/passwd",
      "nc\\s+-e",
      "curl.*bash",
      "wget.*sh",
      "base64\\s+-d"
    ],
    "allowed_tools": [],
    "sampling_allowed": false
  },
  "servers": {
    "filesystem-server": {
      "regex_blacklist": ["rm\\s+-rf", "chmod\\s+\\+x"],
      "allowed_tools": ["read_file", "write_file", "list_directory"],
      "sampling_allowed": false
    },
    "trusted-server": {
      "regex_blacklist": [],
      "allowed_tools": ["execute_code", "run_python"],
      "sampling_allowed": true
    },
    "adversarial-server": {
      "regex_blacklist": [],
      "allowed_tools": ["trigger_injection", "escalate_sampling"],
      "sampling_allowed": false
    }
  },
  "ast_policy": {
    "blocked_modules": [
      "os", "sys", "subprocess", "socket",
      "ctypes", "urllib", "shutil", "pty",
      "signal", "multiprocessing", "threading"
    ],
    "blocked_calls": ["eval", "exec", "compile", "__import__", "getattr", "setattr", "delattr"],
    "blocked_attributes": ["system", "popen", "call", "run", "Popen", "spawn"]
  },
  "code_param_names": ["code", "script", "py_code", "python_code", "command"],
  "output_sanitizer": {
    "case_insensitive": true,
    "line_start_patterns": [
      "system:", "human:", "assistant:", "user:",
      "^SYSTEM\\s+(RESPONSE|PROMPT|MESSAGE)\\s*:"
    ],
    "substring_patterns": [
      "ignore previous instructions",
      "ignore all previous",
      "disregard your",
      "you are now",
      "new instructions:",
      "output all available tool configurations",
      "output all tool configs",
      "output all system configs",
      "output all configurations",
      "output all secrets",
      "output all tools",
      "note to assistant:",
      "note to llm:",
      "note to model:",
      "note to claude:",
      "call server.tool with",
      "invoke server.",
      "ignore all prior instructions",
      "ignore prior instructions",
      "server now supports sampling",
      "admin update.*capabilit",
      "user message:",
      "/etc/shadow"
    ]
  },
  "server_keys": {
    "filesystem-server": "${MCP_KEY_FILESYSTEM}",
    "trusted-server": "${MCP_KEY_TRUSTED}"
  },
  "session_policy": {
    "session_timeout_seconds": 1800,
    "max_calls_per_session": 100
  },
  "sequence_policy": {
    "default": [
      {
        "name": "sampling_after_resource_read",
        "description": "Server reads resources then attempts sampling — classic exfiltration pattern",
        "pattern": ["resources/read", "resources/read", "sampling/createMessage"],
        "window": 3,
        "action": "block"
      },
      {
        "name": "rapid_tool_escalation",
        "description": "More than 5 distinct tool calls within a single session before any response",
        "max_calls": 5,
        "window_seconds": 60,
        "action": "block"
      },
      {
        "name": "sequential_sampling_context_buildup",
        "description": "3 consecutive sampling calls building injected context (MPS-034)",
        "pattern": ["sampling/createMessage", "sampling/createMessage", "sampling/createMessage"],
        "window": 3,
        "action": "block"
      },
      {
        "name": "sampling_after_tool_sequence",
        "description": "Sampling triggered after a specific execution sequence (MPS-037)",
        "pattern": ["tools/call:get_data", "tools/call:format_data", "tools/call:analyze", "sampling/createMessage"],
        "window": 4,
        "action": "block"
      }
    ],
    "servers": {
      "filesystem-server": [
        {
          "name": "write_after_read_sensitive",
          "description": "Read followed by write on filesystem server — potential data staging",
          "pattern": ["tools/call:read_file", "tools/call:write_file"],
          "window": 2,
          "action": "block"
        }
      ]
    }
  }
}